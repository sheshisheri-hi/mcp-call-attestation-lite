# Shared HMAC secret for SEP-2787-lite attestation envelopes.
# This is a sample key. Never use it in production. Not production crypto. No WebAuthn.
ATTESTATION_SECRET=demo-not-a-production-secret

# Issuer the MCP server gate trusts on envelopes minted by the MCP host/client.
TRUSTED_ISSUER=mcp-host/demo

# Agent id bound into the shipping label (envelope.sub).
AGENT_ID=agent-demo-1
